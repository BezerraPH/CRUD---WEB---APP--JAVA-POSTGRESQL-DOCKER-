# Copie este arquivo para .env e ajuste os valores:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
#
# Com Docker Compose, POSTGRES_HOST deve ser "postgres" (nome do serviço).

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=indicadores
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ALTERE_ESTA_SENHA

APP_PORT=8080
ADMINER_PORT=8081
